›	defVar --name BobMedicBrawser --type Browser
defVar --name username --type Boolean
defVar --name password --type Boolean
defVar --name loginButtom --type Boolean
defVar --name loginButtom1 --type String
webStart --name BobMedicBrawser --type "Chrome" --userprofilepreferences "AutomationOptimized" --downloadpath "C:\\Users\\Ahmed Elshikh\\AppData\\Local\\IBM Robotic Process Automation\\downloads" BobMedicBrawser=value
webNavigate --url "http://127.0.0.1:8000"
webSet --value operator --selector "CssSelector" --css "#username" --timeout "00:00:01" username=value
webSet --value nova2026 --selector "CssSelector" --css "#password" --timeout "00:00:01" password=value
webWaitElement --selector "CssSelector" --css "#btn-login" --timeout "00:00:03" loginButtom=value
logMessage --message "loginButtom : ${loginButtom}\r\n" --type "Info"
webGet --selector "CssSelector" --css "#btn-login" loginButtom1=value
logMessage --message "loginButtom : ${loginButtom1}\r\n" --type "Info"
webClick --selector "CssSelector" --css "#btn-login"
delay --timeout "00:00:05"
webClick --selector "CssSelector" --css "#toolbar > a"
webClose --name BobMedicBrawser --leavebrowseropen*	23.0.19.0